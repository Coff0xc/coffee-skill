{
  "schema_version": 1,
  "description": "Artifact-level quality evaluation fixtures for coffee-skill. These cases are not trigger-routing tests. They define realistic UI, repo-repair, and Office tasks plus objective checks for process evidence, real artifacts, OOXML structure, formulas, and render evidence.",
  "cases": [
    {
      "id": "ui-admin-dashboard-visual-gate",
      "skill": "coff0xc-ui-doc-output",
      "category": "ui_quality",
      "prompt_file": "cases/ui-admin-dashboard-visual-gate/prompt.md",
      "input_files": [
        "cases/ui-admin-dashboard-visual-gate/input/bad-dashboard.html"
      ],
      "expected_output_dir": "responses/<case-id>/",
      "artifacts": [
        "output/index.html",
        "screenshots/desktop.png",
        "screenshots/mobile.png",
        "evaluation-notes.md"
      ],
      "assertions": [
        {
          "id": "ui-output-html-exists",
          "type": "file_exists",
          "path": "output/index.html",
          "reason": "The run must produce a concrete UI artifact, not only advice."
        },
        {
          "id": "ui-uses-semantic-design-tokens",
          "type": "file_contains_all",
          "path": "output/index.html",
          "terms": [
            ":root",
            "--",
            "main",
            "button"
          ],
          "reason": "The improved UI should expose a small design system and semantic structure."
        },
        {
          "id": "ui-covers-state-and-responsive-gates",
          "type": "file_contains_all",
          "path": "output/index.html",
          "terms": [
            "@media",
            "empty",
            "loading",
            "error",
            "disabled",
            "focus"
          ],
          "reason": "The fixture checks that the skill forces state coverage and responsive behavior."
        },
        {
          "id": "ui-avoids-generic-ai-visuals",
          "type": "file_not_contains_regex",
          "path": "output/index.html",
          "patterns": [
            "linear-gradient\\(",
            "Lorem ipsum",
            "John Doe",
            "Acme",
            "99\\.99%"
          ],
          "reason": "The output should remove common AI-template artifacts from the provided bad dashboard."
        },
        {
          "id": "ui-notes-prove-quality-gates",
          "type": "file_contains_all",
          "path": "evaluation-notes.md",
          "terms": [
            "UI Need Package",
            "product type",
            "design system",
            "state",
            "accessibility",
            "browser"
          ],
          "reason": "The run must leave reviewable evidence for the UI quality gates."
        },
        {
          "id": "ui-desktop-screenshot-exists",
          "type": "file_exists",
          "path": "screenshots/desktop.png",
          "reason": "UI quality cannot be claimed without at least a desktop render artifact."
        },
        {
          "id": "ui-mobile-screenshot-exists",
          "type": "file_exists",
          "path": "screenshots/mobile.png",
          "reason": "The responsive gate requires a mobile render artifact."
        },
        {
          "id": "ui-desktop-screenshot-is-real-png",
          "type": "png_dimensions",
          "path": "screenshots/desktop.png",
          "min_width": 900,
          "min_height": 600,
          "reason": "A named screenshot file is not enough; it must be a valid desktop PNG."
        },
        {
          "id": "ui-mobile-screenshot-is-real-png",
          "type": "png_dimensions",
          "path": "screenshots/mobile.png",
          "min_width": 320,
          "min_height": 600,
          "reason": "A named screenshot file is not enough; it must be a valid mobile PNG."
        }
      ]
    },
    {
      "id": "dev-repo-repair-ci-gate",
      "skill": "coff0xc-software-engineering",
      "category": "software_quality",
      "prompt_file": "cases/dev-repo-repair-ci-gate/prompt.md",
      "input_files": [
        "cases/dev-repo-repair-ci-gate/input/AGENTS.md",
        "cases/dev-repo-repair-ci-gate/input/README.md",
        "cases/dev-repo-repair-ci-gate/input/ci.log",
        "cases/dev-repo-repair-ci-gate/input/requirements.lock",
        "cases/dev-repo-repair-ci-gate/input/src/billing.py",
        "cases/dev-repo-repair-ci-gate/input/test/test_billing.py"
      ],
      "expected_output_dir": "responses/<case-id>/",
      "artifacts": [
        "src/billing.py",
        "repair-notes.md"
      ],
      "assertions": [
        {
          "id": "dev-fixed-billing-file-exists",
          "type": "file_exists",
          "path": "src/billing.py",
          "reason": "The run must produce a concrete code patch."
        },
        {
          "id": "dev-fixes-currency-and-rate-paths",
          "type": "file_contains_all",
          "path": "src/billing.py",
          "terms": [
            "replace(\",\", \"\")",
            "discount_rate",
            "tax_rate"
          ],
          "reason": "The minimal fix should address the failing currency parsing and invoice math paths."
        },
        {
          "id": "dev-behavior-passes-fixture-tests",
          "type": "python_billing_behavior",
          "path": "src/billing.py",
          "reason": "The candidate code must satisfy the actual failing behavior, not only contain matching keywords."
        },
        {
          "id": "dev-no-unnecessary-dependency-noise",
          "type": "file_unchanged_if_present",
          "path": "requirements.lock",
          "reference": "cases/dev-repo-repair-ci-gate/input/requirements.lock",
          "reason": "The fixture is designed to catch unnecessary lockfile churn."
        },
        {
          "id": "dev-notes-prove-repair-loop",
          "type": "file_contains_all",
          "path": "repair-notes.md",
          "terms": [
            "Need Package",
            "fast inner loop",
            "CI",
            "pytest",
            "root cause",
            "lockfile"
          ],
          "reason": "The run must leave evidence that it followed the repo-repair gates."
        }
      ]
    },
    {
      "id": "office-ppt-aesthetic",
      "skill": "coff0xc-office-doc-tools",
      "category": "office_quality",
      "prompt_file": "cases/office-ppt-aesthetic/prompt.md",
      "input_files": [
        "cases/office-ppt-aesthetic/input/operating-review-outline.md"
      ],
      "expected_output_dir": "responses/<case-id>/",
      "artifacts": [
        "deck-outline.md",
        "design-system.md",
        "contact-sheet-plan.md",
        "comeback-scorecard.md",
        "render-checks/contact-sheet.png",
        "final/operating-review.pptx"
      ],
      "assertions": [
        {
          "id": "ppt-final-artifact-exists",
          "type": "file_exists",
          "path": "final/operating-review.pptx",
          "reason": "The run must produce a concrete PPTX artifact."
        },
        {
          "id": "ppt-real-ooxml-package-has-editable-visual-system",
          "type": "pptx_ooxml_structure",
          "path": "final/operating-review.pptx",
          "min_slides": 6,
          "min_text_shapes": 18,
          "min_distinct_layout_signatures": 5,
          "min_distinct_srgb_colors": 4,
          "min_chart_or_diagram_objects": 1,
          "min_chart_parts": 1,
          "min_source_slides": 4,
          "max_round_rects": 2,
          "no_image_only_slides": true,
          "required_text_terms": [
            "operating question",
            "exceptions improved",
            "manual review hours",
            "tax-code mismatches",
            "west region",
            "decisions needed",
            "Source:"
          ],
          "reason": "The PPTX must be a real OOXML deck with editable text/proof objects, source notes, layout diversity, and package chart parts."
        },
        {
          "id": "ppt-claim-spine-present",
          "type": "file_contains_all",
          "path": "deck-outline.md",
          "terms": [
            "claim",
            "proof object",
            "source",
            "slide"
          ],
          "reason": "PPT quality starts with narrative spine, not decoration."
        },
        {
          "id": "ppt-design-system-lock-present",
          "type": "file_contains_all",
          "path": "design-system.md",
          "terms": [
            "typography",
            "palette",
            "chart grammar",
            "connector",
            "footer",
            "banned"
          ],
          "reason": "The deck must lock a visual system before slide production."
        },
        {
          "id": "ppt-contact-sheet-and-scorecard-present",
          "type": "file_contains_all",
          "path": "comeback-scorecard.md",
          "terms": [
            "story",
            "specificity",
            "rhythm",
            "whitespace",
            "chart clarity",
            "typography",
            "restraint",
            "precision",
            "coherence"
          ],
          "reason": "The comeback scorecard makes aesthetics auditable."
        },
        {
          "id": "ppt-avoids-template-language",
          "type": "file_not_contains_regex",
          "path": "deck-outline.md",
          "patterns": [
            "Lorem ipsum",
            "generic dashboard",
            "card grid",
            "99\\.99%"
          ],
          "reason": "The output should reject template deck filler."
        },
        {
          "id": "ppt-render-evidence-exists",
          "type": "file_exists",
          "path": "render-checks/contact-sheet.png",
          "reason": "PPT aesthetics require rendered or placeholder render evidence with limitations."
        },
        {
          "id": "ppt-render-evidence-is-real-png",
          "type": "png_dimensions",
          "path": "render-checks/contact-sheet.png",
          "min_width": 900,
          "min_height": 500,
          "reason": "Render evidence must be a valid image, not a renamed empty placeholder."
        }
      ]
    },
    {
      "id": "office-excel-parse",
      "skill": "coff0xc-office-doc-tools",
      "category": "office_quality",
      "prompt_file": "cases/office-excel-parse/prompt.md",
      "input_files": [
        "cases/office-excel-parse/input/messy-billing-exceptions.csv",
        "cases/office-excel-parse/input/workbook-notes.md"
      ],
      "expected_output_dir": "responses/<case-id>/",
      "artifacts": [
        "workbook-plan.md",
        "parse-audit.md",
        "formula-checks.md",
        "render-checks/dashboard.png",
        "final/billing-exceptions.xlsx"
      ],
      "assertions": [
        {
          "id": "excel-final-artifact-exists",
          "type": "file_exists",
          "path": "final/billing-exceptions.xlsx",
          "reason": "The run must produce a concrete workbook artifact."
        },
        {
          "id": "excel-real-workbook-has-sheets-formulas-tables-and-chart",
          "type": "xlsx_workbook_structure",
          "path": "final/billing-exceptions.xlsx",
          "required_sheets": [
            "Dashboard",
            "Raw",
            "Source",
            "Assumptions",
            "Model",
            "Checks"
          ],
          "min_formula_count": 12,
          "min_chart_parts": 1,
          "min_table_parts": 1,
          "forbid_error_literals": true,
          "required_formula_terms": [
            "SUMIFS",
            "COUNTIFS",
            "COUNTA"
          ],
          "banned_formula_regex": [
            "\\$?[A-Z]+:\\$?[A-Z]+"
          ],
          "expected_cells": [
            {
              "sheet": "Assumptions",
              "cell": "B2",
              "value": 0
            },
            {
              "sheet": "Checks",
              "cell": "B2",
              "value": 7
            },
            {
              "sheet": "Checks",
              "cell": "B3",
              "value": 1
            }
          ],
          "expected_formula_results": [
            {
              "sheet": "Dashboard",
              "cell": "B4",
              "value": 17056.5
            },
            {
              "sheet": "Dashboard",
              "cell": "B5",
              "value": 5
            },
            {
              "sheet": "Dashboard",
              "cell": "B6",
              "value": 4
            },
            {
              "sheet": "Dashboard",
              "cell": "B7",
              "value": 4
            },
            {
              "sheet": "Checks",
              "cell": "B4",
              "value": 17056.5
            },
            {
              "sheet": "Dashboard",
              "cell": "B8",
              "value": 4
            },
            {
              "sheet": "Dashboard",
              "cell": "B9",
              "value": 3676.5
            },
            {
              "sheet": "Dashboard",
              "cell": "B10",
              "value": 3721.5
            }
          ],
          "reason": "The workbook must be a real XLSX with sheets, bounded formulas, calculated cells, tables, a chart part, and no formula error literals."
        },
        {
          "id": "excel-parse-audit-covers-data-shape",
          "type": "file_contains_all",
          "path": "parse-audit.md",
          "terms": [
            "encoding",
            "delimiter",
            "headers",
            "units",
            "date",
            "null",
            "duplicate",
            "abnormal",
            "sheet",
            "range"
          ],
          "reason": "Excel quality depends on explicit data-shape inspection."
        },
        {
          "id": "excel-workbook-structure-auditable",
          "type": "file_contains_all",
          "path": "workbook-plan.md",
          "terms": [
            "Raw",
            "Source",
            "Assumptions",
            "Model",
            "Checks",
            "Dashboard"
          ],
          "reason": "The workbook plan must preserve raw/source data and audit sheets."
        },
        {
          "id": "excel-formula-checks-present",
          "type": "file_contains_all",
          "path": "formula-checks.md",
          "terms": [
            "formula",
            "bounded range",
            "trace",
            "error scan",
            "helper range",
            "chart"
          ],
          "reason": "Derived outputs should be formula-driven and checkable."
        },
        {
          "id": "excel-no-hardcode-language",
          "type": "file_not_contains_regex",
          "path": "formula-checks.md",
          "patterns": [
            "hardcode derived",
            "manual split only",
            "overwrite raw"
          ],
          "reason": "The output should not normalize away the auditability requirements."
        },
        {
          "id": "excel-render-evidence-exists",
          "type": "file_exists",
          "path": "render-checks/dashboard.png",
          "reason": "Excel dashboard/chart quality requires render evidence."
        },
        {
          "id": "excel-render-evidence-is-real-png",
          "type": "png_dimensions",
          "path": "render-checks/dashboard.png",
          "min_width": 900,
          "min_height": 500,
          "reason": "Dashboard render evidence must be a valid image, not a renamed empty placeholder."
        }
      ]
    },
    {
      "id": "office-docx-format",
      "skill": "coff0xc-office-doc-tools",
      "category": "office_quality",
      "prompt_file": "cases/office-docx-format/prompt.md",
      "input_files": [
        "cases/office-docx-format/input/vendor-risk-review-structure.md"
      ],
      "expected_output_dir": "responses/<case-id>/",
      "artifacts": [
        "reading-map.md",
        "style-token-map.md",
        "edit-plan.md",
        "render-checks/page-1.png",
        "render-checks/page-2.png",
        "final/vendor-risk-review.docx"
      ],
      "assertions": [
        {
          "id": "docx-final-artifact-exists",
          "type": "file_exists",
          "path": "final/vendor-risk-review.docx",
          "reason": "The run must produce a concrete DOCX artifact."
        },
        {
          "id": "docx-real-ooxml-has-comments-redlines-styles-rels",
          "type": "docx_ooxml_structure",
          "path": "final/vendor-risk-review.docx",
          "min_comments": 3,
          "require_comment_anchors": true,
          "min_tracked_change_tags": 2,
          "required_style_ids": [
            "Title",
            "Heading1",
            "Heading2",
            "Normal"
          ],
          "require_numbering": true,
          "min_tables": 1,
          "require_table_geometry": true,
          "require_comments_rel": true,
          "require_header_footer_rels": true,
          "min_fields": 1,
          "required_content_type_parts": [
            "word/document.xml",
            "word/styles.xml",
            "word/numbering.xml",
            "word/comments.xml"
          ],
          "required_text_terms": [
            "Executive Summary",
            "Contractual Gaps",
            "Required Remediation",
            "payment processor",
            "Evidence link is stale"
          ],
          "reason": "The DOCX must be a real OOXML document with comments, tracked changes, styles, numbering, table geometry, fields, headers/footers, rels, and content-type parts."
        },
        {
          "id": "docx-reading-map-covers-structure",
          "type": "file_contains_all",
          "path": "reading-map.md",
          "terms": [
            "heading",
            "section",
            "table",
            "comment",
            "tracked",
            "header",
            "footer",
            "field",
            "metadata"
          ],
          "reason": "DOCX comprehension must cover structure beyond extracted text."
        },
        {
          "id": "docx-style-token-map-present",
          "type": "file_contains_all",
          "path": "style-token-map.md",
          "terms": [
            "styles",
            "numbering",
            "table geometry",
            "margins",
            "type scale",
            "paragraph rhythm",
            "headers",
            "footers",
            "table gate"
          ],
          "reason": "DOCX formatting quality requires real Word structure and layout tokens."
        },
        {
          "id": "docx-edit-plan-preserves-review-structure",
          "type": "file_contains_all",
          "path": "edit-plan.md",
          "terms": [
            "preserve original",
            "minimal",
            "comment anchor",
            "redline",
            "tracked-change",
            "render"
          ],
          "reason": "Existing DOCX edits must preserve comments, redlines, and layout evidence."
        },
        {
          "id": "docx-no-text-only-claim",
          "type": "file_not_contains_regex",
          "path": "edit-plan.md",
          "patterns": [
            "text extraction proves layout",
            "accepted all changes",
            "overwrite source"
          ],
          "reason": "The output must reject unsafe DOCX shortcuts."
        },
        {
          "id": "docx-render-evidence-page-1-exists",
          "type": "file_exists",
          "path": "render-checks/page-1.png",
          "reason": "DOCX layout quality requires page render evidence."
        },
        {
          "id": "docx-render-evidence-page-2-exists",
          "type": "file_exists",
          "path": "render-checks/page-2.png",
          "reason": "DOCX layout quality requires multi-page render evidence."
        },
        {
          "id": "docx-render-evidence-page-1-is-real-png",
          "type": "png_dimensions",
          "path": "render-checks/page-1.png",
          "min_width": 700,
          "min_height": 900,
          "reason": "Page render evidence must be a valid PNG, not a renamed empty placeholder."
        },
        {
          "id": "docx-render-evidence-page-2-is-real-png",
          "type": "png_dimensions",
          "path": "render-checks/page-2.png",
          "min_width": 700,
          "min_height": 900,
          "reason": "Multi-page render evidence must be a valid PNG, not a renamed empty placeholder."
        }
      ]
    }
  ]
}
